# Copy this file to .env and replace the placeholder secret before local use.
# Booking writes use MongoDB transactions, so production must use a replica set
# or a managed MongoDB cluster. A local standalone server is fine for health,
# auth, and other single-document operations, but not booking creation/status.
MONGO_URI=mongodb://127.0.0.1:27017/raksharoute
# `npm run dev` overrides this to true only while it owns a temporary local
# database. Keep it false for configured-database and production-style runs.
USE_MEMORY_DB=false
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173
PORT=5001

# Privacy: exact coordinates stay on the backend unless this is explicitly
# enabled and you accept disclosure to the configured public OSRM service.
ROAD_ROUTING_ENABLED=false

# Destructive end-to-end checks require a disposable database and matching API.
# VERIFY_MONGO_URI=mongodb://127.0.0.1:27017/raksharoute-verify?replicaSet=rs0
# VERIFY_API_URL=http://localhost:5001/api
